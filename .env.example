# Database
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_ADMIN_KEY
DATABASE_URL=postgresql+psycopg://leadpilot:REPLACE_WITH_STRONG_RANDOM_PASSWORD@db:5432/leadpilot

# Planned public URL. Enable HTTPS before using OAuth.
PUBLIC_BASE_URL=https://leads.canberravision.com
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_NAME=canberraai_session
SESSION_MAX_AGE_SECONDS=28800

# Google OpenID Connect - configure only after HTTPS and callback registration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_REDIRECT_URI=https://leads.canberravision.com/auth/google/callback

# Microsoft Entra ID placeholders (not enabled)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations/v2.0
MICROSOFT_REDIRECT_URI=https://leads.canberravision.com/auth/microsoft/callback
