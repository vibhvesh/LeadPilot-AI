# Copy to .env for local development. Never commit .env.
# Placeholders only. Replace every secret before a server is reachable.
# Docker Compose reads this same file. See DOCKER.md.

# demo = local sign-in without Google. Search and model calls still need their own keys.
# Set DEMO_MODE=false on any server that is reachable from the internet.
DEMO_MODE=true
APP_ENV=development

# sqlite is enough for a local demo. Docker Compose overrides this with its Postgres service.
DATABASE_URL=sqlite:///./data/leadpilot.db

# At least 32 characters. Generate with: openssl rand -hex 32
# Keep the same value when moving a database. It also unlocks saved provider keys
# when ENCRYPTION_KEY is empty.
SESSION_SECRET=replace-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=leadpilot_session
SESSION_MAX_AGE_SECONDS=28800
# true behind HTTPS (Render, Caddy). false for http://localhost
SESSION_COOKIE_SECURE=false

# Used to encrypt provider keys saved from the API key page.
# If empty, SESSION_SECRET is used. Set a separate value in production.
ENCRYPTION_KEY=

PUBLIC_BASE_URL=http://localhost:8000
SUPER_ADMIN_EMAIL=vibhvesh@gmail.com

# Google OAuth web client. Leave blank to use demo sign-in only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
# Defaults to PUBLIC_BASE_URL + /auth/google/callback
GOOGLE_REDIRECT_URI=

# Search: auto uses Tavily, then Brave. With neither key, search returns an error and no leads.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
# Optional. Read-only bearer token for public X posts on the Social page. Never used to post.
X_API_KEY=

# LLM keys. With AI routing set to Auto, the first configured provider is used.
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
XAI_MODEL=grok-3
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o-mini

# Natural-language AI search runs this many query rounds when results stay thin.
AI_SEARCH_MAX_ROUNDS=2

# Optional outbound webhook when someone clicks Deep search with Grok Bot.
# The JSON body is {request_id, text, plan, callback_base_url}.
# GROKBOT_WEBHOOK_SECRET is sent as the X-LeadPilot-Webhook-Secret header.
GROKBOT_WEBHOOK_URL=
GROKBOT_WEBHOOK_SECRET=

# --- Docker Compose ---
# Ignored by a local uvicorn process. Required before `docker compose up`.
# Generate the database password with: openssl rand -hex 24
# On a public VPS set LEADPILOT_BIND=0.0.0.0, DEMO_MODE=false, and APP_ENV=production.
# HTTP/IP mode: TLS_MODE=http and leave LEADPILOT_DOMAIN empty.
# Automatic HTTPS: TLS_MODE=https, LEADPILOT_DOMAIN=leads.example.com,
# ACME_EMAIL=you@example.com, PUBLIC_BASE_URL=https://leads.example.com,
# SESSION_COOKIE_SECURE=true.
DB_PASSWORD=replace-with-openssl-rand-hex-24
POSTGRES_USER=leadpilot
POSTGRES_DB=leadpilot
TLS_MODE=http
LEADPILOT_DOMAIN=
ACME_EMAIL=
LEADPILOT_BIND=0.0.0.0
LEADPILOT_HTTP_PORT=80
LEADPILOT_HTTPS_PORT=443
LEADPILOT_APP_PORT=1102
