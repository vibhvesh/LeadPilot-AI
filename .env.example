# Database
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_ADMIN_KEY

# Database URL
DATABASE_URL=postgresql+psycopg://leadpilot:REPLACE_WITH_STRONG_RANDOM_PASSWORD@db:5432/leadpilot

# Public application URL (HTTPS in production)
PUBLIC_BASE_URL=https://YOUR_CANBERRAAI_HOST
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
SESSION_COOKIE_NAME=canberraai_session
SESSION_MAX_AGE_SECONDS=28800

# Microsoft Entra ID (multi-tenant work/school accounts)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTHORITY=https://login.microsoftonline.com/organizations/v2.0
MICROSOFT_REDIRECT_URI=https://YOUR_CANBERRAAI_HOST/auth/microsoft/callback

# Google OpenID Connect
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_REDIRECT_URI=https://YOUR_CANBERRAAI_HOST/auth/google/callback

# Do not enable provider buttons until each provider is configured and the
# corresponding authentication, membership, and RBAC implementation is deployed.
